<?xml version="1.0" encoding="utf-8"?>
<!-- PlayerView with a TextureView surface: required so PauseEffects' RenderEffect can reach the
     video frame (a SurfaceView's video lives in a separate layer). Used only when a pause effect
     toggle is on; the default path constructs PlayerView directly. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    app:surface_type="texture_view"
    app:use_controller="false" />
