<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up: keep the encrypted login out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="jetflix_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jetflix_session.xml" />
    </device-transfer>
</data-extraction-rules>
